  - {fileID: 811932630}
  - {fileID: 489160853}
  - {fileID: 505110431}
  optionButtonTexts:
  - {fileID: 1950774601}
  - {fileID: 734546573}
  - {fileID: 843807126}
  continuePrompt: {fileID: 8774658494042170962}
  playerController: {fileID: 2192165737370580323}
  playerAnimator: {fileID: 463103172}
  questTrigger: {fileID: 7956678442700216759}
  typingSpeed: 0.05
  successThreshold: 40
  questions:
  - speakerNames:
    - Personality A
    - Personality B
    - Personality A
    - Personality B
    dialogueLines:
    - I want to go up! There's grass up there!
    - No "going up
    - Why are we even in the basement?
    - The basement is safe. Grass is suspicious
    optionTexts:
    - What about slow, leisurely standing?
    - Standing? That's almost running!
    - Up we go!
    correctOptions: 010100
  - speakerNames:
    - Personality A
    - Personality B
    - Personality A
    - Personality B
    dialogueLines:
    - ' They don''t understand us'
    - People don't understand much in general.
    - Even we don't sometimes.
    - That's normal. Dogs don't explain everything either
    optionTexts:
    - I don't always understand myself either. It works.
    - Alright, I give up
    - Maybe try explaining again?
    correctOptions: 010001
  - speakerNames:
    - Personality A
    - Personality B
    - Personality A
    - Personality B
    dialogueLines:
    - I want the rug. The rug is good.
    - The rug smells like the mag. I don't like it
    - Everything smells like the mag. That's life
    - Bad life
    optionTexts:
    - The mag isn't that bad.
    - The rug can be washed. The mag is temporary.
    correctOptions: 0001
  - speakerNames:
    - Personality A
    - Personality B
    - Personality A
    - Personality B
    dialogueLines:
    - "He created us\u2026 but didn't explain why"
    - Unpleasant
    - I want explanations
    - And a bone
    optionTexts:
    - The mag doesn't have to explain
    - Explanations later. The bone too
    - Let's figure this out first; then the old man will bring bones
    correctOptions: 000001
  - speakerNames:
    - Personality A
    - Personality B
    - Girl
    - Personality B
    - Personality A
    - Personality B
    dialogueLines:
    - The mag yells sometimes
    - Loudly
    - He's tired
    - ' I''m tired too. But I don''t yell.'
    - "We\u2026 think you're not an enemy"
    - Not an enemy. But not really one of us either
    optionTexts:
    - I'll try to help, even if it doesn't work at first.
    - Then stay in the basement
    - You're good. Just confused
    correctOptions: 010001
